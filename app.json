{
  "expo": {
    "name": "Tidy",
    "slug": "photo-sorter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.photosorter.home"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.photosorter.home"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Tidy shows your photos so you can sort them into albums and delete the ones you don’t want.",
          "savePhotosPermission": "Tidy adds the photos you keep to your albums.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/44bdeb09-87db-4db5-a930-822c691637b4",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "owner": "pjr413",
    "extra": {
      "eas": {
        "projectId": "44bdeb09-87db-4db5-a930-822c691637b4"
      }
    }
  }
}
